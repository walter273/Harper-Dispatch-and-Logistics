# This file documents the environment variables. Node does not load it automatically.
# Keep a real .env file local only; it is ignored by Git.
ALPHAWAY_HOST=127.0.0.1
ALPHAWAY_DATA_FILE=./data/alphaway-store.json
ALPHAWAY_REQUIRE_AUTH=false
ALPHAWAY_PREVIEW_USERNAME=
ALPHAWAY_PREVIEW_PASSWORD=
ALPHAWAY_ADMIN_TOKEN=
ALPHAWAY_PRIVATE_NETWORK=false
# Required when ALPHAWAY_PRIVATE_NETWORK=true. Share only with approved carriers.
ALPHAWAY_NETWORK_INVITE_CODE=
ALPHAWAY_FMCSA_QCMOBILE_KEY=
ALPHAWAY_FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
ALPHAWAY_ACCOUNT_AUTH=false
ALPHAWAY_REQUIRE_SUBSCRIPTION=false
ALPHAWAY_ACCOUNT_SESSION_SECRET=
ALPHAWAY_ADMIN_EMAIL=
ALPHAWAY_ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
# Authorized sandbox account identifier; this is not a secret.
STRIPE_ACCOUNT_ID=acct_1UDJTIKqpp58H3DU
# Live mode is intentionally disabled.
# Prefer a restricted sandbox key with permissions needed by billing.js.
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_CARRIER=price_1UDWf7Kqpp58H3DU1oRYxBT0
STRIPE_PRICE_SHIPPER=price_1UDWfCKqpp58H3DU1xjnfinA
STRIPE_PRICE_BROKER=price_1UDWfGKqpp58H3DUgiOa6GtG
# Hosted GoDaddy origin. Use http://127.0.0.1:4173 only for local development.
STRIPE_PUBLIC_BASE_URL=https://app.alphawaylogistics.com
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# For GoDaddy, use the hosted settings in GODADDY-SETUP.md.
# Keep secrets in GoDaddy's Secrets settings, not in this example or Git.
