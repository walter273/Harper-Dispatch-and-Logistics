# This file documents the environment variables. Node does not load it automatically.
# Keep a real .env file local only; it is ignored by Git.
HARPER_HOST=127.0.0.1
HARPER_DATA_FILE=./data/harper-store.json
HARPER_REQUIRE_AUTH=false
HARPER_PREVIEW_USERNAME=
HARPER_PREVIEW_PASSWORD=
HARPER_ADMIN_TOKEN=
HARPER_PRIVATE_NETWORK=false
# Required when HARPER_PRIVATE_NETWORK=true. Share only with approved carriers.
HARPER_NETWORK_INVITE_CODE=
HARPER_FMCSA_QCMOBILE_KEY=
HARPER_FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
# Server-only credentials for the public Ask Harper website assistant.
# The chat falls back to its built-in help guide when OPENAI_API_KEY is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
HARPER_ACCOUNT_AUTH=false
HARPER_REQUIRE_SUBSCRIPTION=false
HARPER_ACCOUNT_SESSION_SECRET=
HARPER_ADMIN_EMAIL=
HARPER_ADMIN_PASSWORD=
# Payment provider. Square is the only provider in use; the legacy Stripe path
# has been removed from the server, so no provider switch or fallback exists.
# Selects sandbox unless this is exactly 'production'.
SQUARE_ENVIRONMENT=sandbox
# Sandbox credentials. Used whenever SQUARE_ENVIRONMENT is not 'production'.
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
# Production credentials. Leave empty until live collection is approved.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Production collection stays locked until this is exactly 'true'. Even with
# production tokens set, omitting it keeps live charges disabled.
SQUARE_LIVE_PAYMENTS_ENABLED=false
# Signed webhook verification. When unset, a configured webhook record is used.
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# One-time startup helpers; leave unset for normal operation.
SQUARE_SANDBOX_SMOKE_TEST=false
SQUARE_CONFIGURE_WEBHOOK=false
SQUARE_SANDBOX_TEST_EMAIL=
# Applicant workflow email. Never use an @alphawaylogistics.com or
# @alphawaylogisticsllc.com address or origin: AlphaWay access is gone and
# cannot be recovered. Set all three explicitly; a wrong sender fails silently.
HARPER_APPLICANT_EMAILS_ENABLED=false
HARPER_EMAIL_PROVIDER=twilio
HARPER_EMAIL_FROM=dispatch@harperloadboard.com
HARPER_EMAIL_REPLY_TO=info@harperloadboard.com
HARPER_PUBLIC_ORIGIN=https://www.harperloadboard.com
# Use the exact public app origin; localhost is for development only.
# See OPERATIONS-READINESS.md for the current Railway deployment.
# Keep secrets in hosting variables, not in this example or Git.
