# This file documents the environment variables. Node does not load it automatically.
# Keep a real .env file local only; it is ignored by Git.
ALPHAWAY_HOST=127.0.0.1
ALPHAWAY_DATA_FILE=./data/alphaway-store.json
ALPHAWAY_REQUIRE_AUTH=false
ALPHAWAY_PREVIEW_USERNAME=
ALPHAWAY_PREVIEW_PASSWORD=
ALPHAWAY_ADMIN_TOKEN=
ALPHAWAY_PRIVATE_NETWORK=false
# Required when ALPHAWAY_PRIVATE_NETWORK=true. Share only with approved carriers.
ALPHAWAY_NETWORK_INVITE_CODE=
ALPHAWAY_FMCSA_QCMOBILE_KEY=
ALPHAWAY_FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
ALPHAWAY_ACCOUNT_AUTH=false
ALPHAWAY_REQUIRE_SUBSCRIPTION=false
ALPHAWAY_ACCOUNT_SESSION_SECRET=
ALPHAWAY_ADMIN_EMAIL=
ALPHAWAY_ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
# Test is the default. Live requires matching live resources and a completed readiness review.
STRIPE_MODE=test
# Enable only after payment/cancellation tests and the tax review are complete.
# This blocks new live Checkouts; webhook processing and existing customer portals stay available.
STRIPE_LIVE_PAYMENTS_ENABLED=false
STRIPE_ACCOUNT_ID=
# Use a server-only key with the permissions needed by billing.js.
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_DISPATCH_BASIC=
STRIPE_PRICE_DISPATCH_STANDARD=
STRIPE_PRICE_DISPATCH_PREMIUM=
STRIPE_PRICE_CARRIER_ONBOARDING=
STRIPE_PRICE_SHIPPER=
STRIPE_PRICE_BROKER=
# Applicant workflow email. Never use an @alphawaylogistics.com or
# @alphawaylogisticsllc.com address or origin: AlphaWay access is gone and
# cannot be recovered. Set all three explicitly; a wrong sender fails silently.
ALPHAWAY_APPLICANT_EMAILS_ENABLED=false
ALPHAWAY_EMAIL_PROVIDER=twilio
ALPHAWAY_EMAIL_FROM=dispatch@harperloadboard.com
ALPHAWAY_EMAIL_REPLY_TO=info@harperloadboard.com
ALPHAWAY_PUBLIC_ORIGIN=https://www.harperloadboard.com
# Use the exact public app origin; localhost is for development only.
STRIPE_PUBLIC_BASE_URL=http://127.0.0.1:4173
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# See OPERATIONS-READINESS.md for the current Railway deployment.
# Keep secrets in hosting variables, not in this example or Git.

# Harper AI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
