# This file documents the environment variables. Node does not load it automatically.
# Keep a real .env file local only; it is ignored by Git.
ALPHAWAY_HOST=127.0.0.1
ALPHAWAY_DATA_FILE=./data/alphaway-store.json
ALPHAWAY_REQUIRE_AUTH=false
ALPHAWAY_PREVIEW_USERNAME=
ALPHAWAY_PREVIEW_PASSWORD=
ALPHAWAY_ADMIN_TOKEN=
